
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MarketPro | Digital Marketing Agency</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
    scroll-behavior: smooth;
}

body {
    background: #f8faff;
    color: #17233c;
}

/* Navbar */
header {
    background: white;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 15px #00000010;
}

.logo {
    font-size: 27px;
    font-weight: bold;
    color: #4b57db;
}

nav a {
    text-decoration: none;
    color: #17233c;
    margin-left: 25px;
    font-weight: 600;
}

nav a:hover {
    color: #4b57db;
}

.menu-btn {
    display: none;
    font-size: 28px;
    cursor: pointer;
    border: none;
    background: none;
}

/* Hero */
.hero {
    min-height: 600px;
    padding: 100px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    background: linear-gradient(120deg, #eef0ff, #f8faff);
}

.hero-content {
    max-width: 550px;
}

.hero h1 {
    font-size: 55px;
    line-height: 1.2;
    margin-bottom: 20px;
}

.hero h1 span {
    color: #4b57db;
}

.hero p {
    color: #68748b;
    line-height: 1.8;
    margin-bottom: 30px;
}

.btn {
    display: inline-block;
    padding: 14px 28px;
    background: #4b57db;
    color: white;
    text-decoration: none;
    border-radius: 7px;
    border: none;
    cursor: pointer;
    font-size: 15px;
    transition: 0.3s;
}

.btn:hover {
    background: #303db5;
    transform: translateY(-3px);
}

.hero-image {
    width: 45%;
    max-width: 500px;
    border-radius: 20px;
}

/* General Sections */
section {
    padding: 85px 8%;
}

.section-title {
    text-align: center;
    margin-bottom: 45px;
}

.section-title h2 {
    font-size: 36px;
    margin-bottom: 12px;
}

.section-title p {
    color: #778197;
}

/* Services */
.services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.service-card {
    background: white;
    padding: 35px 25px;
    border-radius: 15px;
    box-shadow: 0 5px 25px #00000008;
    transition: 0.3s;
}

.service-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 10px 30px #4b57db20;
}

.service-card .icon {
    font-size: 40px;
    margin-bottom: 20px;
}

.service-card h3 {
    margin-bottom: 15px;
}

.service-card p {
    color: #778197;
    line-height: 1.7;
}

/* About */
.about {
    background: #eef0ff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
}

.about-content {
    max-width: 550px;
}

.about h2 {
    font-size: 36px;
    margin-bottom: 20px;
}

.about p {
    color: #68748b;
    line-height: 1.9;
    margin-bottom: 20px;
}

.about img {
    width: 45%;
    border-radius: 20px;
}

/* Statistics */
.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    text-align: center;
    background: #4b57db;
    color: white;
}

.stat h2 {
    font-size: 38px;
    margin-bottom: 10px;
}

/* Pricing */
.pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.price-card {
    background: white;
    padding: 35px;
    text-align: center;
    border-radius: 15px;
    box-shadow: 0 5px 25px #00000010;
}

.price-card.featured {
    border: 2px solid #4b57db;
    transform: scale(1.04);
}

.price {
    font-size: 35px;
    color: #4b57db;
    margin: 20px 0;
    font-weight: bold;
}

.price-card ul {
    list-style: none;
    line-height: 2.5;
    margin-bottom: 20px;
    color: #68748b;
}

/* Testimonials */
.testimonial {
    background: #eef0ff;
    text-align: center;
}

.testimonial-box {
    max-width: 700px;
    margin: auto;
    background: white;
    padding: 40px;
    border-radius: 15px;
}

.testimonial-box p {
    line-height: 1.8;
    color: #68748b;
    margin: 15px 0;
}

/* Contact */
.contact-container {
    max-width: 650px;
    margin: auto;
}

.contact-form {
    display: grid;
    gap: 18px;
}

.contact-form input,
.contact-form textarea {
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 7px;
    outline: none;
    font-size: 15px;
}

.contact-form input:focus,
.contact-form textarea:focus {
    border-color: #4b57db;
}

.contact-form textarea {
    min-height: 130px;
    resize: vertical;
}

/* Footer */
footer {
    background: #17233c;
    color: white;
    text-align: center;
    padding: 30px;
}

footer p {
    color: #c4cce0;
}

/* Animations */
.fade {
    animation: fadeIn 1s ease;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(25px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Responsive */
@media(max-width: 900px) {
    .services-grid,
    .pricing-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .hero h1 {
        font-size: 42px;
    }
}

@media(max-width: 650px) {
    header {
        padding: 18px 5%;
    }

    .menu-btn {
        display: block;
    }

    nav {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        background: white;
        padding: 20px;
    }

    nav.active {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    nav a {
        margin: 0;
    }

    .hero,
    .about {
        flex-direction: column;
        text-align: center;
        padding: 70px 5%;
    }

    .hero h1 {
        font-size: 36px;
    }

    .hero-image,
    .about img {
        width: 100%;
    }

    .services-grid,
    .pricing-grid,
    .stats {
        grid-template-columns: 1fr;
    }

    .price-card.featured {
        transform: none;
    }

    section {
        padding: 65px 5%;
    }
}
</style>
</head>

<body>

